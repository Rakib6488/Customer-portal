rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // common functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Session validation - Pillar 2
    function isValidSession(data) {
      return data.keys().hasAll(['id', 'name', 'loginTime', 'status', 'currentActivity', 'lastActive'])
        && data.keys().size() >= 6 && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.loginTime is string && data.loginTime.size() <= 50
        && data.status is string && (data.status == 'offline' || data.status == 'available' || data.status == 'on_break')
        && data.currentActivity is string && data.currentActivity.size() <= 100
        && data.lastActive is string && data.lastActive.size() <= 50
        && (!('shiftTimer' in data) || data.shiftTimer is int)
        && (!('breakTimer' in data) || data.breakTimer is int)
        && (!('agentId' in data) || (data.agentId is string && data.agentId.size() <= 128));
    }

    // Break validation - Pillar 2 & 5
    function isValidBreak(data) {
      return data.keys().hasAll(['id', 'agentId', 'agentName', 'startTime', 'reason', 'status'])
        && data.keys().size() >= 6 && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.agentId is string && data.agentId.size() <= 128
        && data.agentName is string && data.agentName.size() <= 100
        && data.startTime is string && data.startTime.size() <= 50
        && data.reason is string && data.reason.size() <= 200
        && data.status is string && (data.status == 'active' || data.status == 'completed')
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 50))
        && (!('duration' in data) || data.duration is int);
    }

    // Sessions rules
    match /agent_sessions/{sessionId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(sessionId)
        && isValidSession(incoming());
        
      allow update: if isSignedIn()
        && isValidId(sessionId)
        && isValidSession(incoming())
        // Pillar 12: Immutability constraints
        && incoming().id == existing().id
        && incoming().loginTime == existing().loginTime;
        
      allow delete: if isSignedIn();
    }

    // Breaks rules
    match /breaks/{breakId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(breakId)
        && isValidBreak(incoming());
        
      allow update: if isSignedIn()
        && isValidId(breakId)
        && isValidBreak(incoming())
        // Pillar 12: Immutability constraints
        && incoming().id == existing().id
        && incoming().agentId == existing().agentId
        && incoming().startTime == existing().startTime;
        
      allow delete: if isSignedIn();
    }

    // Config rules
    match /config/{configId} {
      allow read, write: if isSignedIn();
    }
  }
}
